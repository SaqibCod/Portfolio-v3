# Frontend environment variables.
# Copy to .env.local and fill in real values. Only NEXT_PUBLIC_* reaches the browser.

# Public site origin, no trailing slash. Used for canonical URLs, sitemap and OG tags (phase 02).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the Spring Boot API, no trailing slash (phase 02).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
