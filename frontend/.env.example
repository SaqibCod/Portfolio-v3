# Frontend environment variables.
# Copy to .env.local and fill in real values. Only NEXT_PUBLIC_* reaches the browser.

# Public site origin, no trailing slash. Used for canonical URLs, sitemap and OG tags (phase 02).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the Spring Boot API, no trailing slash (phase 02).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Cloudflare Turnstile site key for the contact form (phase 04) and the guestbook (phase 05).
# Public by design: it identifies the widget to Cloudflare and is readable in
# the page source of anything that renders one. The matching *secret* key is
# backend-only (TURNSTILE_SECRET_KEY in backend/.env) and must never appear here.
#
# Local development: use one of Cloudflare's documented test site keys. They need
# no Turnstile account and always give the same verdict:
#   1x00000000000000000000AA  always passes, visible widget   (the value below)
#   2x00000000000000000000AB  always fails, visible widget    (use to test the 422 path)
#   1x00000000000000000000BB  always passes, invisible widget
#   3x00000000000000000000FF  forces an interactive challenge
# A test site key produces a dummy token that a *real* secret key rejects, so the
# site key here and the backend's secret key must always be from the same set:
#   1x00000000000000000000AA  pairs with  1x0000000000000000000000000000000AA
#   2x00000000000000000000AB  pairs with  2x0000000000000000000000000000000AA
#
# Production: create a Turnstile widget at
# https://dash.cloudflare.com/?to=/:account/turnstile, add the deployed hostname
# to it, then set this to that widget's site key and TURNSTILE_SECRET_KEY on the
# backend to its secret key. The pair is per-widget: mixing keys from two widgets
# fails verification with invalid-input-response.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
