# Backend environment variables.
# Copy to .env and fill in real values. Never commit the filled-in file.
#
# How this file is loaded: the `local` profile imports it via `spring.config.import` in
# application-local.yml, parsed as a properties file. So run the backend as
#   cd backend && ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
# from the backend/ directory. Without the `local` profile this file is ignored and every
# value must come from the real environment.
#
# Because it is parsed as a .properties file: `#` starts a comment, `\` is an escape
# character, and quotes are kept literally — so leave values unquoted.
#
# The `local` profile already defaults every value below to something that works, so you only
# need a .env to override one.

# Database (defaults below match docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/portfolio
DB_USERNAME=portfolio
DB_PASSWORD=portfolio

# Public base URL of this API, no trailing slash. Also the base of every RFC 9457 problem
# `type` URI (<API_BASE_URL>/problems/<slug>). Those URIs are identifiers clients match on, so
# set this to the real domain before launch and avoid changing it afterwards.
# Defaults to the https://api.example.com placeholder when unset.
API_BASE_URL=https://api.example.com

# CORS: comma-separated list of browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Security
# Salt mixed into every client IP hash (raw IPs are never stored). Any long random string.
IP_HASH_SALT=change-me-to-a-long-random-string
# Bearer token for /api/v1/admin/**. Generate at least 32 random bytes, e.g.
#   openssl rand -base64 48
ADMIN_TOKEN=change-me-to-at-least-32-random-characters

# Cloudflare Turnstile server-side secret.
# For local development use one of Cloudflare's documented test secret keys -- never a real
# one. They need no Turnstile account and always give the same verdict:
#   1x0000000000000000000000000000000AA  always passes  (the local default)
#   2x0000000000000000000000000000000AA  always fails    (use to test the 422 path)
#   3x0000000000000000000000000000000AA  always yields "token already spent"
# Test site keys produce a dummy token (XXXX.DUMMY.TOKEN.XXXX) that a real secret key rejects,
# so the frontend test site key and a test secret key must always be used together
# (phase 04, NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA pairs with 1x0...AA here).
#
# In production, create a widget at https://dash.cloudflare.com/?to=/:account/turnstile, list the
# deployed frontend hostname on it, and set this to that widget's secret key with the frontend's
# NEXT_PUBLIC_TURNSTILE_SITE_KEY set to the same widget's site key. The two are a pair: keys from
# different widgets fail verification with invalid-input-response, which the API answers as a 422.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Email (Resend). Under the local and test profiles mail is logged, not sent.
RESEND_API_KEY=re_change_me
MAIL_FROM=portfolio@example.com
OWNER_EMAIL=owner@example.com
