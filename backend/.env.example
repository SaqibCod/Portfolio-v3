# Backend environment variables.
# Copy to .env and fill in real values. Never commit the filled-in file.

# Database (defaults below match docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/portfolio
DB_USERNAME=portfolio
DB_PASSWORD=portfolio

# Public base URL of this API, no trailing slash. Also the base of every RFC 9457 problem
# `type` URI (<API_BASE_URL>/problems/<slug>). Those URIs are identifiers clients match on, so
# set this to the real domain before launch and avoid changing it afterwards.
# Defaults to the https://api.example.com placeholder when unset.
API_BASE_URL=https://api.example.com

# CORS: comma-separated list of browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Security
# Salt mixed into every client IP hash (raw IPs are never stored). Any long random string.
IP_HASH_SALT=change-me-to-a-long-random-string
# Bearer token for /api/v1/admin/**. Generate at least 32 random bytes, e.g.
#   openssl rand -base64 48
ADMIN_TOKEN=change-me-to-at-least-32-random-characters

# Cloudflare Turnstile server-side secret.
# Test keys: 1x0000000000000000000000000000000AA always passes,
#            2x0000000000000000000000000000000AA always fails.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Email (Resend). Under the local and test profiles mail is logged, not sent.
RESEND_API_KEY=re_change_me
MAIL_FROM=portfolio@example.com
OWNER_EMAIL=owner@example.com
